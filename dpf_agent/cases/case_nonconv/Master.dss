! 极端应力算例：极端过载 + 高阻抗（电压深度崩溃）
! 用途：配合 --max-iterations 1 产生确定性的 non_converged 样例（文档 17.2 / 9.4）
! 默认求解参数下该算例数值收敛但电压崩溃（最低约 0.001 pu），可用于演示
! “converged 不等于安全”的状态语义分离（文档 13.3）。
Clear
New Circuit.CaseNonConv basekv=12.66 pu=1.00 phases=3 bus1=src
~ MVAsc3=1000 MVAsc1=900

New Line.L1 phases=3 bus1=src bus2=b2 r1=5.0 x1=8.0 r0=10.0 x0=16.0 normamps=400
New Line.L2 phases=3 bus1=b2  bus2=b3 r1=6.0 x1=9.0 r0=12.0 x0=18.0 normamps=400
New Line.L3 phases=3 bus1=b3  bus2=b4 r1=7.0 x1=10.0 r0=14.0 x0=20.0 normamps=400

New Load.L2 bus1=b2 phases=3 kv=12.66 kw=90000  kvar=45000 model=1
New Load.L3 bus1=b3 phases=3 kv=12.66 kw=120000 kvar=60000 model=1
New Load.L4 bus1=b4 phases=3 kv=12.66 kw=150000 kvar=75000 model=1

Set VoltageBases=[12.66]
Calcvoltagebases
Set controlmode=off
